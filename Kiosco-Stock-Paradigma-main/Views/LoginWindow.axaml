<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StockVentas.Views.LoginWindow"
        Title="Iniciar sesión - StockVentas"
        Width="380" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24" Spacing="10" VerticalAlignment="Center">
    <TextBlock Text="StockVentas" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
    <TextBlock Text="Ingresá con tu usuario y contraseña" HorizontalAlignment="Center" Margin="0,0,0,10" />

    <TextBlock Text="Usuario" />
    <TextBox x:Name="txtUsuario" />

    <TextBlock Text="Contraseña" />
    <TextBox x:Name="txtPassword" PasswordChar="•" KeyDown="TxtPassword_KeyDown" />

    <Button x:Name="btnIngresar" Content="Ingresar" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center" Margin="0,10,0,0" Click="BtnIngresar_Click" />

    <TextBlock x:Name="txtEstadoLogin" TextWrapping="Wrap" HorizontalAlignment="Center" />
  </StackPanel>
</Window>
